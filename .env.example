# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/speaking_coach?schema=public"

# ─── Gemini AI ────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET="change-me-at-least-64-chars-long-random-string"
JWT_REFRESH_SECRET="another-long-random-string-for-refresh-tokens"

# ─── API Server ───────────────────────────────────────────────
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"

# ─── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_WEBHOOK_URL="https://your-api.railway.app/bot/webhook"
# The public URL of the deployed web app (for WebApp button)
WEB_APP_URL="https://your-app.vercel.app"

# ─── Frontend ─────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001"
VITE_BOT_USERNAME="@your_bot_username"
